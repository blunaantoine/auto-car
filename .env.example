# Local : la même URL pour les deux variables.
# Supabase : DATABASE_URL = pooler en mode transaction (port 6543) avec ?pgbouncer=true&connection_limit=1
#            DIRECT_URL   = connexion en mode session (port 5432), utilisée par prisma migrate
DATABASE_URL="postgresql://interglobe:interglobe@localhost:5432/interglobe"
DIRECT_URL="postgresql://interglobe:interglobe@localhost:5432/interglobe"
# Base de test (utilisée par les tests d'intégration)
TEST_DATABASE_URL="postgresql://interglobe:interglobe@localhost:5432/interglobe_test"
# Affiche les codes de vérification à l'écran. Développement ou déploiement de TEST uniquement.
DEV_SHOW_VERIFICATION_CODES="true"
# Photos des véhicules (Supabase Storage, bucket public "vehicle-photos").
# Clé secrète : Supabase → Project Settings → API Keys → secret / service_role. Côté serveur uniquement.
SUPABASE_URL="https://pghuascoofqnaqslukec.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
